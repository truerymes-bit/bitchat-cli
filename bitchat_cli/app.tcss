/* All colours come from palette.py via $bc-* variables (BitchatApp.get_css_variables). */

Screen {
    background: $bc-bg;
    color: $bc-text;
}

/* ---- Header ---------------------------------------------------------- */
/* Height is content-driven: brand row + Tabs row + border, <= 5 rows. */
#app-header {
    height: auto;
    background: $bc-panel;
    padding: 0 1;
    border: solid $bc-emerald;
}

#header-top {
    height: 1;
}

#wordmark {
    width: 1fr;
    text-style: bold;
    color: $bc-emerald;
}

#link-container {
    width: auto;
    height: 100%;
}

#link-dot, #link-state {
    width: auto;
    text-style: bold;
    color: $bc-muted;
}

#conv-tabs {
    height: 2;
    border: none;
    background: $bc-panel;
}

/* ---- Conversation ---------------------------------------------------- */
#conversation {
    height: 1fr;
    border: solid $bc-emerald;
    background: $bc-panel;
}

#room-header {
    height: 2;
    background: $bc-bar;
    border-bottom: solid $bc-emerald;
    padding: 0 1;
    width: 100%;
}

#room-online {
    color: $bc-text;
}

#conversation-switcher {
    height: 1fr;
}

ConversationView {
    height: 1fr;
    border: none;
    background: $bc-panel;
    padding: 0 1;
    scrollbar-color: $bc-emerald;
    scrollbar-background: $bc-panel;
    scrollbar-size-vertical: 1;
}

/* ---- Input ----------------------------------------------------------- */
#input-panel {
    height: 3;
    background: $bc-panel-alt;
    border: solid $bc-emerald;
    padding: 0 1;
}

#input-prompt {
    width: 2;
    color: $bc-emerald;
    text-style: bold;
}

#input {
    width: 1fr;
    height: 1;
    border: none;
    background: transparent;
    color: $bc-text;
}

#input-hint {
    width: auto;
    padding: 0 1;
}

#input > .input--cursor {
    background: $bc-emerald;
    color: $bc-bg;
}

#input > .input--placeholder {
    color: $bc-muted;
}

/* ---- Footer ---------------------------------------------------------- */
#footer {
    height: 3;
    background: $bc-bg;
    padding: 0 1;
    border: solid $bc-emerald;
}

KeyHint {
    width: auto;
    height: 1;
}

.keycap {
    width: auto;
    height: 1;
    padding: 0 1;
    border-left: solid $bc-emerald;
    border-right: solid $bc-emerald;
    color: $bc-emerald;
}

.keylabel {
    width: auto;
    height: 1;
    padding: 0 2 0 1;
    color: $bc-muted;
}

.footer-spacer {
    width: 1fr;
    height: 1;
}

/* ---- Settings modal -------------------------------------------------- */
SettingsScreen {
    align: center middle;
    background: $bc-bg 60%;
}

#settings-box {
    width: 50;
    height: auto;
    border: solid $bc-emerald;
    background: $bc-panel;
    padding: 1 2;
}

#settings-title {
    color: $bc-emerald;
    text-style: bold;
}

#settings-label {
    color: $bc-muted;
    margin-top: 1;
}

#settings-nick {
    border: solid $bc-emerald;
    background: $bc-panel-alt;
    color: $bc-text;
}

#settings-id {
    color: $bc-muted;
    margin-top: 1;
}

#settings-hint {
    margin-top: 1;
}

/* ---- Responsive breakpoints (classes set on Screen from on_resize) --- */
/* Fixed single-row header + vertical conversation: no per-width class
   swaps required. Narrow widths only shrink the chat pane, so none kept. */
